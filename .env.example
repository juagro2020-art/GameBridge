# Application
PROJECT_NAME="GameBridge Ethiopian Esports Ladder"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY="replace-this-with-a-random-secret-key-in-production"
APP_URL="http://localhost:8000"

# Database (Postgres in production, SQLite for local dev)
DATABASE_URL="sqlite+aiosqlite:///./gamebridge.db"
SYNC_DATABASE_URL="sqlite:///./gamebridge.db"
# Production Postgres example:
# DATABASE_URL="postgresql+asyncpg://gamebridge:gamebridge_pass@localhost:5432/gamebridge_db"
# SYNC_DATABASE_URL="postgresql://gamebridge:gamebridge_pass@localhost:5432/gamebridge_db"

# Telegram Integration
TELEGRAM_BOT_TOKEN="your_bot_token_from_botfather"
TELEGRAM_BOT_USERNAME="GameBridgeEthBot"
TELEGRAM_WEBHOOK_SECRET="your_webhook_secret_token"

# External APIs
LICHESS_API_BASE="https://lichess.org"
CHESS_COM_API_BASE="https://api.chess.com/pub"
CHESS_COM_USER_AGENT="GameBridgeEsports/1.0 (contact: info@gamebridge.et)"

# Demo Mode
DEMO_MODE=True
